package com.meet.methodchaning;

public class Person {
	private int id;
	private String name;
	private int age;

	private Person() {
		System.out.println("This is private constructor...");

	}

	public void setId(int id) {
		this.id = id;
	}

	public void setName(String name) {
		this.name = name;
	}

	public void setAge(int age) {
		this.age = age;
	}

}
