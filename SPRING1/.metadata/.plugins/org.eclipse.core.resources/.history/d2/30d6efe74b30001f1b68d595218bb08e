package com.meet.methodchaning;

public class Person {
	private int id;
	private String name;
	private int age;

	private Person() {
		System.out.println("This is private constructor...");

	}

	public Person setId(int id) {
		this.id = id;
		return this;
	}

	public Person setName(String name) {
		this.name = name;
		return this;
	}

	public Person setAge(int age) {
		this.age = age;
		return this;
	}
	
	public static Person of() {
		return new Person();
	}

}
